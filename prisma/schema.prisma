generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// MODELOS DO NEXT AUTH (OBRIGATÓRIOS)
model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  telefone             String?   @unique
  subscriptionStatus   String    @default("free")
  stripeSubscriptionId String?
  stripeCustomerId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // NextAuth relationships
  accounts         Account[]
  sessions         Session[]
  taxPlans         TaxPlan[]
  estudoProgresso  EstudoProgresso?
  concursos        Concurso[]
  concursoAcessos     ConcursoAcesso[]
  concursoProgressos  ConcursoProgressoUsuario[]
  mensagensEnviadas    Mensagem[] @relation("MensagensEnviadas")
  mensagensRecebidas   Mensagem[] @relation("MensagensRecebidas")

  username        String?   @unique

  empresasReforma  EmpresaReforma[]
  clientesRecuperacaoCredito ClienteRecuperacaoCredito[]
  resumosEstudo    ResumoEstudo[]
  simuladoTentativas  SimuladoTentativa[]
  discursivaRespostas DiscursivaResposta[]
  campanhasRPG        CampanhaRPG[]
}

// Resumos gerados por IA na aba "Resumos" do Estudo: o usuário sobe um PDF de material, a IA
// devolve markdown (pontos que mais caem, pegadinhas, conceitos com analogias) e o resumo fica
// salvo vinculado à matéria/tópico. Fora do blob EstudoProgresso.dados de propósito — resumos
// são grandes e inflariam o autosave (o state inteiro é POSTado com debounce a cada mudança).
model ResumoEstudo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  materia     String
  topico      String   @default("")
  titulo      String
  arquivoNome String
  conteudo    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, materia])
}


model TaxPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  cnpj        String?
  regimeAtual String
  estado      String
  setor       String
  porte       String
  dados       Json
  analiseIA   Json?
  status      String   @default("draft")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EstudoProgresso {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmpresaReforma {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj                String
  razaoSocial         String
  nomeFantasia        String?
  regime              String    // SIMPLES_I | SIMPLES_II | SIMPLES_III | LUCRO_PRESUMIDO | LUCRO_REAL
  simplesNacional     Boolean   @default(false)
  uf                  String
  municipio           String?
  cnaePrincipal       String?
  faturamento         Float
  aliquotaICMS        Float
  aliquotaICMSCompras Float     @default(0)
  temIPI              Boolean   @default(false)
  aliquotaIPI         Float?
  percentualIPISaidas Float?
  temFCBF             Boolean   @default(false)
  fcbfPercentual      Float?
  fcbfBaseCalculo     Float?
  parametrosExtra     Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  simulacoes          SimulacaoReforma[]
  dadosXml            DadosXmlReforma?

  @@unique([userId, cnpj])
}

model SimulacaoReforma {
  id         String         @id @default(cuid())
  empresaId  String
  empresa    EmpresaReforma @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  premissas  Json
  resultados Json
  usouXml    Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model Concurso {
  id          String             @id @default(cuid())
  // dono único — mantido só durante a migração pra currículo compartilhado (ConcursoAcesso);
  // depois que a fase de "contract" rodar, este campo e isPrincipal/progresso saem daqui
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrincipal Boolean            @default(false)
  progresso   ConcursoProgresso?
  // dono de verdade a partir da migração pra currículo compartilhado — auditoria apenas (quem
  // criou), não controla acesso (isso é ConcursoAcesso)
  criadoPorUserId String?
  nome        String
  orgao       String?
  foto        String?
  dataProva   DateTime?
  materias    Json               // MateriaConcurso[] — currículo, compartilhado
  // metade curricular (compartilhada) de TopicoState/Bloco — links QuestFlow/TecConcursos,
  // importância, nome/tópicos do bloco. Chaves: topicosCompartilhados por "materia||topico"
  // (topicoKey), blocosCompartilhados por Bloco.id. O resultado (acertos/erros, estudado) fica
  // em ConcursoProgressoUsuario, por usuário.
  topicosCompartilhados Json     @default("{}")
  blocosCompartilhados  Json     @default("{}")
  acessos     ConcursoAcesso[]
  progressos  ConcursoProgressoUsuario[]
  pdfs        PdfConcurso[]
  simulados       SimuladoConcurso[]
  discursivaTemas DiscursivaTema[]
  questoesRpg     QuestaoRPG[]
  campanhasRPG    CampanhaRPG[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// legado — 1:1 por concurso, será removido depois que ConcursoProgressoUsuario assumir de vez
// (fase "contract" da migração pra currículo compartilhado)
model ConcursoProgresso {
  id         String   @id @default(cuid())
  concursoId String   @unique
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  dados      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// quem pode acessar um Concurso — substitui o dono único (Concurso.userId) pra permitir que o
// mesmo curso seja compartilhado por várias pessoas, cada uma com seu próprio isPrincipal (antes
// modelado errado como coluna do Concurso, quando na verdade sempre foi um conceito por usuário)
model ConcursoAcesso {
  id          String   @id @default(cuid())
  concursoId  String
  concurso    Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrincipal Boolean  @default(false)
  criadoEm    DateTime @default(now())

  @@unique([concursoId, userId])
  @@index([userId])
}

// progresso de UM usuário num Concurso (possivelmente compartilhado) — trilha, cartas,
// calendário, config do ciclo, resultado dos cadernos de questões (acertos/erros por grupo A-D)
// e tudo mais que é individual, mesmo quando o currículo (Concurso.materias/topicosCompartilhados/
// blocosCompartilhados) e os PDFs (PdfConcurso) são os mesmos pra todo mundo com acesso
model ConcursoProgressoUsuario {
  id         String   @id @default(cuid())
  concursoId String
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([concursoId, userId])
  @@index([userId])
}

// biblioteca de PDFs compartilhada por concurso — metadados/mapeamento de capítulos são
// currículo (mesmos pra todo mundo); progresso de leitura (página atual, questões respondidas)
// fica em ConcursoProgressoUsuario.dados.pdfsProgresso, por usuário
model PdfConcurso {
  id                String   @id @default(cuid())
  concursoId        String
  concurso          Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  nome              String
  materia           String
  topicos           Json?
  totalPaginas      Int
  paginaConteudoFim Int?
  intervalosPaginas Json?
  capitulos         Json?
  // caminho real no Supabase Storage — não depende mais de convenção "${userId}/${id}.pdf"
  // (que quebrava assim que um segundo usuário tentasse acessar o mesmo arquivo)
  storagePath       String
  arquivoEnviado    Boolean  @default(false)
  criadoPorUserId   String?
  criadoEm          DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([concursoId])
}

// currículo de simulados (compartilhado por concurso) — PDF da prova real + gabarito oficial por
// parte. Resultado de cada tentativa fica em SimuladoTentativa, por usuário. Um simulado pode ter
// várias partes com PDFs DIFERENTES (ex.: prova de Conhecimentos Gerais num PDF, Conhecimentos
// Específicos noutro) — por isso o arquivo é por PARTE, não um storagePath único no topo (ver
// campo `storagePath`/`arquivoEnviado` dentro de cada item de `partes`, não mais aqui).
model SimuladoConcurso {
  id              String   @id @default(cuid())
  concursoId      String
  concurso        Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  nome            String
  orgao           String?
  banca           String?
  ano             Int?
  // partes: [{ id: "geral"|"especifica", nome, numeroQuestoes, tempoMinutos, storagePath?,
  //            arquivoEnviado, gabarito: [{ numero, alternativaCorreta }] }]
  partes          Json
  criadoPorUserId String?
  criadoEm        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tentativas      SimuladoTentativa[]

  @@index([concursoId])
}

// tentativa de um usuário num SimuladoConcurso — cronômetro de parede (ancorado em iniciadoEm,
// não em memória) + respostas marcadas por parte
model SimuladoTentativa {
  id           String           @id @default(cuid())
  simuladoId   String
  simulado     SimuladoConcurso @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String           // "em_andamento" | "concluida"
  // partes: [{ parteId, iniciadoEm?, concluidoEm?, respostas: [{ numero, alternativaMarcada }] }]
  partes       Json
  criadoEm     DateTime         @default(now())
  concluidaEm  DateTime?

  @@index([simuladoId, userId])
  @@index([userId, concluidaEm])
}

// tema de discursiva (compartilhado por concurso) — rubrica opcional pra IA usar na correção
model DiscursivaTema {
  id              String   @id @default(cuid())
  concursoId      String
  concurso        Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  materia         String?
  tema            String
  orientacoes     String?  @db.Text
  pontosChave     Json?    // string[] — rubrica opcional pra IA
  criadoPorUserId String?
  criadoEm        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  respostas       DiscursivaResposta[]

  @@index([concursoId])
}

// resposta de um usuário a um DiscursivaTema — texto + correção da IA (nota 0-10 + feedback)
model DiscursivaResposta {
  id            String         @id @default(cuid())
  temaId        String
  tema          DiscursivaTema @relation(fields: [temaId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  texto         String         @db.Text
  notaIA        Float?
  feedbackIA    Json?          // { pontosFortes, pontosFracos, sugestoes, justificativa }
  minutosGastos Int?
  criadoEm      DateTime       @default(now())

  @@index([temaId, userId])
  @@index([userId, criadoEm])
}

// banco de questões do RPG (aba Mapa) — usadas pelos mobs do campo de treino em vez da pergunta
// única fixa do protótipo inicial. Importadas de cadernos impressos em PDF do TecConcursos
// (exportação oficial do site, não scraping) via script — ver docs da sessão. Compartilhado por
// concurso, mesmo padrão de SimuladoConcurso/DiscursivaTema (currículo, não progresso por usuário
// — a "resposta" de uma luta é efêmera na UI, não precisa de tabela própria ainda).
model QuestaoRPG {
  id              String   @id @default(cuid())
  concursoId      String
  concurso        Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  // id da questão no TecConcursos, quando importada de lá — evita duplicar se o mesmo caderno for
  // reimportado por engano
  tecConcursosId  String?
  banca           String
  cargo           String?
  orgao           String?
  area            String?
  ano             String?
  materia         String
  topico          String
  enunciado       String   @db.Text
  alternativas    Json     // { A: "...", B: "...", C: "...", D: "...", E?: "..." }
  correta         String   // "A".."E"
  criadoPorUserId String?
  criadoEm        DateTime @default(now())

  @@index([concursoId, materia])
}

// Progresso de UMA campanha roguelike (aba Mapa) — POR USUÁRIO, diferente de QuestaoRPG/inimigos
// (currículo, compartilhado). Mesmo espírito de SimuladoTentativa: uma linha ativa por
// (concurso, usuário). Campos de corrida resetam numa "Nova Campanha" (morrer também reseta);
// campos permanentes (itens, xpPermanente, histórico) nunca resetam — é o que torna isso um
// roguelike de verdade, não só uma barra de progresso que reinicia do zero sempre.
model CampanhaRPG {
  id          String   @id @default(cuid())
  concursoId  String
  concurso    Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   // "em_andamento" | "morto" | "vitoria"
  // --- corrida atual: reseta em "Nova Campanha" ---
  heroiHP      Int
  heroiHPMax   Int      @default(28)
  ouroCorrida  Int      @default(0)
  xpCorrida    Int      @default(0)
  rota         Json     @default("[]") // [{ materia, topico }] gerada no início da corrida
  posicaoAtual Int      @default(0)    // índice dentro de `rota`
  iniciadaEm   DateTime @default(now())
  // --- permanente: NUNCA reseta, sobrevive à morte ---
  itens                Json @default("[]") // string[] ids de item possuídos (fase futura, vazio por enquanto)
  xpPermanente         Int  @default(0)    // pro sistema de título/nível (fase futura)
  topicosVencidosTotal Json @default("[]") // topicoKey[] vencidos em QUALQUER corrida (histórico)
  updatedAt            DateTime @updatedAt

  @@unique([concursoId, userId])
  @@index([userId])
}

// "Mandar Incentivo" — mensagem direta de um usuário pra outro (aba Pré-Aprovados do Estudo).
// Restrita no backend a quem compartilha pelo menos um ConcursoAcesso (não é uma DM genérica do
// app inteiro, só entre quem estuda junto pro mesmo concurso).
model Mensagem {
  id             String   @id @default(cuid())
  remetenteId    String
  remetente      User     @relation("MensagensEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatarioId String
  destinatario   User     @relation("MensagensRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  texto          String
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now())

  @@index([destinatarioId, lida])
}

model DadosXmlReforma {
  id                  String         @id @default(cuid())
  empresaId           String         @unique
  empresa             EmpresaReforma @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodos            String[]
  totalNFs            Int
  totalItens          Int
  totalVProd          Float
  totalVICMS          Float
  totalVPIS           Float
  totalVCOFINS        Float
  totalVIPI           Float
  totalBaseIbsCbs     Float
  aliquotaICMSEfetiva Float
  aliquotaIPIEfetiva  Float
  percentualIPISaidas Float
  mesesImportados     Int
  itens               Json
  createdAt           DateTime       @default(now())
}

model ClienteRecuperacaoCredito {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj         String
  razaoSocial  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projetos     ProjetoRecuperacaoCredito[]

  @@unique([userId, cnpj])
}

model ProjetoRecuperacaoCredito {
  id          String                    @id @default(cuid())
  clienteId   String
  cliente     ClienteRecuperacaoCredito @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome        String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  declaracoes               DeclaracaoPgdas[]
  declaracoesEfd            DeclaracaoEfdIcmsIpi[]
  declaracoesEfdContrib     DeclaracaoEfdContribuicoes[]
  comprovantesPagamento     DeclaracaoComprovantePagamento[]
  declaracoesEcf            DeclaracaoEcf[]
  declaracoesDctfWeb        DeclaracaoDctfWeb[]
  declaracoesDctf           DeclaracaoDctf[]
  declaracoesFontesPagadoras DeclaracaoFontesPagadoras[]
  declaracoesEcd            DeclaracaoEcd[]
  cadastro                  CadastroEmpresa?
}

// Dados cadastrais que alimentam a aba "Menu" do Excel: Consulta CNPJ, QSA e Consulta Optantes
// do Simples Nacional. Um registro por projeto; dados é um DadosCadastroEmpresa
// (src/lib/cadastro-parser.ts) — cada documento enviado preenche a sua chave via merge.
model CadastroEmpresa {
  id        String                    @id @default(cuid())
  projetoId String                    @unique
  projeto   ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  cnpj      String
  dados     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeclaracaoPgdas {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM", chave de ordenação/coluna do Excel
  tipoDocumento  String   // "DECLARACAO" | "EXTRATO"
  cnpj           String   // CNPJ lido do PDF (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosPgdas em src/lib/pgdas/types.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia, tipoDocumento])
  @@index([projetoId, competencia])
}

model DeclaracaoEfdIcmsIpi {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM", chave de ordenação/coluna do Excel
  cnpj           String   // CNPJ lido do EFD (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEfdIcmsIpi em src/lib/efd-icms-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

// Diferente de DeclaracaoPgdas/EfdIcmsIpi/EfdContribuicoes (1 arquivo = 1 competência), um único
// PDF de Comprovante de Arrecadação pode conter dezenas de DARFs de períodos diferentes — então a
// unidade persistida aqui é o DARF individual, deduplicado pelo Número do Documento (chave
// natural do próprio DARF, estável mesmo que o mesmo PDF seja reenviado ou que o DARF apareça em
// PDFs diferentes exportados em datas distintas).
model DeclaracaoComprovantePagamento {
  id              String                    @id @default(cuid())
  projetoId       String
  projeto         ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  numeroDocumento String   // chave natural do DARF — usada pra deduplicar reimportação
  cnpj            String   // CNPJ lido do PDF (auditoria/validação contra o cliente)
  arquivoNome     String
  dados           Json     // payload tipado — ver DadosComprovantePagamento em src/lib/comprovante-pagamento-parser.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projetoId, numeroDocumento])
  @@index([projetoId])
}

// DCTFWeb — declaração completa (PDF). 1 arquivo = 1 período de apuração (mês); os débitos
// declarados (códigos de receita) ficam no JSON. competência = "YYYY-MM".
model DeclaracaoDctfWeb {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM" (período de apuração da declaração)
  cnpj           String
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosDctfWeb em src/lib/dctfweb-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

// DCTF (arquivo .dec do PGD DCTF Mensal). 1 arquivo = 1 competência (mês); os débitos declarados
// (grupos/tributos) ficam no JSON. competência = "YYYY-MM".
model DeclaracaoDctf {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM"
  cnpj           String
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosDctf em src/lib/dctf-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

// Fontes Pagadoras (relatório DIRF do e-CAC) — rendimentos e retenções por fonte pagadora. 1
// arquivo = 1 ano-calendário; as fontes e seus códigos de retenção ficam no JSON.
model DeclaracaoFontesPagadoras {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY" (ano-calendário)
  cnpj           String   // CNPJ do beneficiário (validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosFontesPagadoras em src/lib/fontes-pagadoras-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

// ECD (Escrituração Contábil Digital) — plano de contas + saldos do Balanço Patrimonial. 1
// arquivo = 1 ano-calendário; as contas (com tipo/natureza e saldos trimestrais) ficam no JSON.
model DeclaracaoEcd {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY" (ano-calendário)
  cnpj           String
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEcd em src/lib/ecd-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

// ECF (Escrituração Contábil Fiscal) — IRPJ/CSLL. Um arquivo = um ano-calendário inteiro (com
// os períodos trimestrais dentro do JSON), então a "competência" aqui é só o ano ("2021").
model DeclaracaoEcf {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY" (ano-calendário)
  cnpj           String   // CNPJ lido do ECF (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEcf em src/lib/ecf-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

model DeclaracaoEfdContribuicoes {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM", chave de ordenação/coluna do Excel
  cnpj           String   // CNPJ lido do EFD (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEfdContribuicoes em src/lib/efd-contribuicoes-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}
