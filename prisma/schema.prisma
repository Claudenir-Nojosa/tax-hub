generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// MODELOS DO NEXT AUTH (OBRIGATÓRIOS)
model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  telefone             String?   @unique
  subscriptionStatus   String    @default("free")
  stripeSubscriptionId String?
  stripeCustomerId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // NextAuth relationships
  accounts         Account[]
  sessions         Session[]
  taxPlans         TaxPlan[]
  estudoProgresso  EstudoProgresso?

  username        String?   @unique

  empresasReforma  EmpresaReforma[]
}


model TaxPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  cnpj        String?
  regimeAtual String
  estado      String
  setor       String
  porte       String
  dados       Json
  analiseIA   Json?
  status      String   @default("draft")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EstudoProgresso {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmpresaReforma {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj                String
  razaoSocial         String
  nomeFantasia        String?
  regime              String    // SIMPLES_I | SIMPLES_II | SIMPLES_III | LUCRO_PRESUMIDO | LUCRO_REAL
  simplesNacional     Boolean   @default(false)
  uf                  String
  municipio           String?
  cnaePrincipal       String?
  faturamento         Float
  aliquotaICMS        Float
  aliquotaICMSCompras Float     @default(0)
  temIPI              Boolean   @default(false)
  aliquotaIPI         Float?
  percentualIPISaidas Float?
  temFCBF             Boolean   @default(false)
  fcbfPercentual      Float?
  fcbfBaseCalculo     Float?
  parametrosExtra     Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  simulacoes          SimulacaoReforma[]
  dadosXml            DadosXmlReforma?

  @@unique([userId, cnpj])
}

model SimulacaoReforma {
  id         String         @id @default(cuid())
  empresaId  String
  empresa    EmpresaReforma @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  premissas  Json
  resultados Json
  usouXml    Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model DadosXmlReforma {
  id                  String         @id @default(cuid())
  empresaId           String         @unique
  empresa             EmpresaReforma @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodos            String[]
  totalNFs            Int
  totalItens          Int
  totalVProd          Float
  totalVICMS          Float
  totalVPIS           Float
  totalVCOFINS        Float
  totalVIPI           Float
  totalBaseIbsCbs     Float
  aliquotaICMSEfetiva Float
  aliquotaIPIEfetiva  Float
  percentualIPISaidas Float
  mesesImportados     Int
  itens               Json
  createdAt           DateTime       @default(now())
}
