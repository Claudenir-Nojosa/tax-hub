generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// MODELOS DO NEXT AUTH (OBRIGATÓRIOS)
model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  telefone             String?   @unique
  subscriptionStatus   String    @default("free")
  stripeSubscriptionId String?
  stripeCustomerId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // NextAuth relationships
  accounts         Account[]
  sessions         Session[]
  taxPlans         TaxPlan[]
  estudoProgresso  EstudoProgresso?
  concursos        Concurso[]

  username        String?   @unique

  empresasReforma  EmpresaReforma[]
  clientesRecuperacaoCredito ClienteRecuperacaoCredito[]
}


model TaxPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  cnpj        String?
  regimeAtual String
  estado      String
  setor       String
  porte       String
  dados       Json
  analiseIA   Json?
  status      String   @default("draft")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EstudoProgresso {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmpresaReforma {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj                String
  razaoSocial         String
  nomeFantasia        String?
  regime              String    // SIMPLES_I | SIMPLES_II | SIMPLES_III | LUCRO_PRESUMIDO | LUCRO_REAL
  simplesNacional     Boolean   @default(false)
  uf                  String
  municipio           String?
  cnaePrincipal       String?
  faturamento         Float
  aliquotaICMS        Float
  aliquotaICMSCompras Float     @default(0)
  temIPI              Boolean   @default(false)
  aliquotaIPI         Float?
  percentualIPISaidas Float?
  temFCBF             Boolean   @default(false)
  fcbfPercentual      Float?
  fcbfBaseCalculo     Float?
  parametrosExtra     Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  simulacoes          SimulacaoReforma[]
  dadosXml            DadosXmlReforma?

  @@unique([userId, cnpj])
}

model SimulacaoReforma {
  id         String         @id @default(cuid())
  empresaId  String
  empresa    EmpresaReforma @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  premissas  Json
  resultados Json
  usouXml    Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model Concurso {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome        String
  orgao       String?
  foto        String?
  dataProva   DateTime?
  isPrincipal Boolean            @default(false)
  materias    Json               // MateriaConcurso[]
  progresso   ConcursoProgresso?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ConcursoProgresso {
  id         String   @id @default(cuid())
  concursoId String   @unique
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  dados      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DadosXmlReforma {
  id                  String         @id @default(cuid())
  empresaId           String         @unique
  empresa             EmpresaReforma @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodos            String[]
  totalNFs            Int
  totalItens          Int
  totalVProd          Float
  totalVICMS          Float
  totalVPIS           Float
  totalVCOFINS        Float
  totalVIPI           Float
  totalBaseIbsCbs     Float
  aliquotaICMSEfetiva Float
  aliquotaIPIEfetiva  Float
  percentualIPISaidas Float
  mesesImportados     Int
  itens               Json
  createdAt           DateTime       @default(now())
}

model ClienteRecuperacaoCredito {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj         String
  razaoSocial  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projetos     ProjetoRecuperacaoCredito[]

  @@unique([userId, cnpj])
}

model ProjetoRecuperacaoCredito {
  id          String                    @id @default(cuid())
  clienteId   String
  cliente     ClienteRecuperacaoCredito @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome        String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  declaracoes               DeclaracaoPgdas[]
  declaracoesEfd            DeclaracaoEfdIcmsIpi[]
  declaracoesEfdContrib     DeclaracaoEfdContribuicoes[]
  comprovantesPagamento     DeclaracaoComprovantePagamento[]
  declaracoesEcf            DeclaracaoEcf[]
}

model DeclaracaoPgdas {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM", chave de ordenação/coluna do Excel
  tipoDocumento  String   // "DECLARACAO" | "EXTRATO"
  cnpj           String   // CNPJ lido do PDF (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosPgdas em src/lib/pgdas/types.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia, tipoDocumento])
  @@index([projetoId, competencia])
}

model DeclaracaoEfdIcmsIpi {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM", chave de ordenação/coluna do Excel
  cnpj           String   // CNPJ lido do EFD (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEfdIcmsIpi em src/lib/efd-icms-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

// Diferente de DeclaracaoPgdas/EfdIcmsIpi/EfdContribuicoes (1 arquivo = 1 competência), um único
// PDF de Comprovante de Arrecadação pode conter dezenas de DARFs de períodos diferentes — então a
// unidade persistida aqui é o DARF individual, deduplicado pelo Número do Documento (chave
// natural do próprio DARF, estável mesmo que o mesmo PDF seja reenviado ou que o DARF apareça em
// PDFs diferentes exportados em datas distintas).
model DeclaracaoComprovantePagamento {
  id              String                    @id @default(cuid())
  projetoId       String
  projeto         ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  numeroDocumento String   // chave natural do DARF — usada pra deduplicar reimportação
  cnpj            String   // CNPJ lido do PDF (auditoria/validação contra o cliente)
  arquivoNome     String
  dados           Json     // payload tipado — ver DadosComprovantePagamento em src/lib/comprovante-pagamento-parser.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projetoId, numeroDocumento])
  @@index([projetoId])
}

// ECF (Escrituração Contábil Fiscal) — IRPJ/CSLL. Um arquivo = um ano-calendário inteiro (com
// os períodos trimestrais dentro do JSON), então a "competência" aqui é só o ano ("2021").
model DeclaracaoEcf {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY" (ano-calendário)
  cnpj           String   // CNPJ lido do ECF (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEcf em src/lib/ecf-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}

model DeclaracaoEfdContribuicoes {
  id             String                    @id @default(cuid())
  projetoId      String
  projeto        ProjetoRecuperacaoCredito @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  competencia    String   // "YYYY-MM", chave de ordenação/coluna do Excel
  cnpj           String   // CNPJ lido do EFD (auditoria/validação contra o cliente)
  arquivoNome    String
  dados          Json     // payload tipado — ver DadosEfdContribuicoes em src/lib/efd-contribuicoes-parser.ts

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projetoId, competencia])
  @@index([projetoId, competencia])
}
